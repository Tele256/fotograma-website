---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/articles-style.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Articole - Fotograma.ro" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		 {import.meta.env.MODE === "production" && (
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N8M4LXLS"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>)}
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<main>
			<section class="main-section">
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
								</a>
								<div class="tag-container">
								{post.data.tags?.map(tag => (
									<a href={`/tags/${tag.toLowerCase()}`} class="tag">{tag}</a>
								))}
								</div>
								<a href={`/blog/${post.id}`}>
									<h4 class="title">{post.data.title}</h4>
								</a>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
								
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
