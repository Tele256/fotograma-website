---
import BaseHead from '../components/BaseHead.astro';
import FallbackImage from '../assets/fotograma-banner.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/home-style.css';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const image = FallbackImage;

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const latestPosts = posts
  .slice(0, 4);

const featuredPost = latestPosts[0];


const base = import.meta.env.BASE_URL;

const reviewPosts = posts
  .filter(post => post.data.tags?.includes('review'))
  .slice(0, 3);

const newsPosts = posts
  .filter(post => (post.data.tags?.includes('stire') || post.data.tags?.includes('eveniment')) || (post.data.tags?.includes('stire') && post.data.tags?.includes('eveniment')))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const siteImage = new URL('/src/assets/Logo-small.png', import.meta.url);
---

<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <BaseHead title="Fotograma.ro" description="Pasiunea pentru fotografie, in cuvinte. News outlet-ul NR. 1 din Romania pentru fotografie." />
  <meta property="og:title" content="Fotograma.ro" />
  <meta property="og:description" content="Pasiunea pentru fotografie, in cuvinte. News outlet-ul NR. 1 din Romania pentru fotografie." />
  <meta property="og:image" content={new URL(image.src, Astro.url)} />
  <title>Articole - Fotograma.ro</title>
</head>
<body>
  
  
  <!-- Google Tag Manager (noscript) -->
   {import.meta.env.MODE === "production" && (
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N8M4LXLS"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>)}
  <!-- End Google Tag Manager (noscript) -->
  <Header />
  <main1>
    <div class="centerer">
	
	  <section class="latest-articles">
      <div class="featured-article">
        <ul class="featured-post">
          {[featuredPost].map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="featured-link">
                <div class="image-wrapper">
                  {post.data.heroImageCover && (
                    <Image
                      width={960}
                      height={480}
                      src={post.data.heroImageCover}
                      alt=""
                    />
                  )}

                  <div class="overlay">
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <h5>{post.data.title}</h5>
                    <p style="text-decoration: underline;">Citeste articolul</p>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="related-header">
        <h2>Te-ar mai putea interesa:</h2>
      </div>
      <div class="related-articles">		
        <ul class="post-grid">
          {
          latestPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="post-card">
                {post.data.heroImage && (
                <Image width={480} height={120} src={post.data.heroImage} alt="" />
                )}
                <div class="title-date-container">
                  <h5>{post.data.title}</h5>
                  <p class="date">
                  <FormattedDate date={post.data.pubDate} />
                  </p>
                </div>
              </a>
            </li>
          ))
          }
        </ul>
      </div>
		</section>
      <section class="reviews-news">
        <div class="reviews-container">
          <div class="reviews">
            <div class="reviews-header">
              <h3>Review-urile noastre</h3>
              <a class="cta-review" href={`/review`}>Vezi Tot</a>
            </div>
            <div class="review-grid">
              {reviewPosts.map(post => (
                <a href={`/blog/${post.id}`} class="review-link">
                  <article class="review-card">
                    {post.data.reviewImage && (
                      <Image width={240} height={60} src={post.data.reviewImage} alt="" />
                    )}
                    <div class="vl"></div>
                    <h3>{post.data.reviewTitle}</h3>
                  </article>
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="news-container">
          <div class="news">
            <div class="news-header">
              <h3>Stiri si evenimente</h3>
              <a class="cta-news" href={`/blog`}>Vezi Tot</a>
            </div>
            <div class="news-grid">
              {newsPosts.map(post => (
                <article class="news-card">
                  <a href={`/blog/${post.id}`} class="news-link">
                    {post.data.heroImage && (
                      <Image width={480} height={120} src={post.data.heroImage} alt="" />
                    )}
                  </a>
                  <div class="tag-title">
                    <div class="tag-container">
                      {post.data.tags?.map(tag => (
                        <a href={`/tags/${tag.toLowerCase()}`} class="tag">{tag}</a>
                      ))}
                    </div>
                    <a href={`/blog/${post.id}`} class="news-link">
                      <h3>{post.data.title}</h3>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
      <section class="articles-section">
        <div class="news-container">
          <div class="news">
            <div class="news-header">
              <h3>Mai multe articole</h3>
              <a class="cta-news" href={`/blog`}>Vezi Tot</a>
            </div>
            <div class="news-grid">
              {posts.slice(1, 10).map(post => (
                <article class="news-card">
                  <a href={`/blog/${post.id}`} class="news-link">
                    {post.data.heroImage && (
                      <Image width={480} height={120} src={post.data.heroImage} alt="" />
                    )}
                  </a>
                  <div class="tag-title">
                    <div class="tag-container">
                      {post.data.tags?.map(tag => (
                        <a href={`/tags/${tag.toLowerCase()}`} class="tag">{tag}</a>
                      ))}
                    </div>
                    <a href={`/blog/${post.id}`} class="news-link">
                      <h3>{post.data.title}</h3>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    </div>
  </main1>
  <Footer />
</body>
</html>